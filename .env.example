# ==============================================================================
# Daily Hadith AI Agent — Environment Configuration Example (.env.example)
#
# COPY THIS FILE TO '.env' AND FILL IN YOUR REAL CREDENTIALS.
# NEVER COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Logging
# ------------------------------------------------------------------------------
APP_ENV=development                       # development | staging | production
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR | CRITICAL
TIMEZONE=Asia/Kolkata                     # Must be valid IANA timezone (mandatory 10:00 AM IST delivery)
SCHEDULE_CRON="0 10 * * *"               # Daily at 10:00 AM

# ------------------------------------------------------------------------------
# HadeethEnc Source Configuration
# ------------------------------------------------------------------------------
HADEETHENC_BASE_URL=https://hadeethenc.com/api/v1
HADEETHENC_TIMEOUT_SECONDS=10.0
HADEETHENC_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# Telegram Bot Delivery (Configured in Milestone 12)
# ------------------------------------------------------------------------------
# Obtained via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal or target channel Telegram Chat ID
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# Groq LLM Configuration (Configured in Milestone 09)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=512

# ------------------------------------------------------------------------------
# Database Persistence (Local SQLite by default; Neon PG for Cloud Deploy)
# ------------------------------------------------------------------------------
# Local development default: sqlite+aiosqlite:///./data/daily_hadith.db
DATABASE_URL=sqlite:///./daily_hadith.db

# ------------------------------------------------------------------------------
# Optional External Research / MCP Tooling (Tavily)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=tvly_your_tavily_api_key_here
